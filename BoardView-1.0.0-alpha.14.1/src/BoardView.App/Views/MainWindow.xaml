<Window x:Class="BoardView.App.Views.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BoardView.App.Controls"
        Title="BoardView — Repair Workspace"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True"
        Closing="OnClosing"
        DragOver="OnDragOver"
        Drop="OnDrop">
  <Grid Background="{StaticResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="72" />
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <Menu Grid.Row="0" VerticalContentAlignment="Center">
      <MenuItem Header="Archivo">
        <MenuItem Header="Abrir placa..." Command="{Binding Workspace.OpenBoardCommand, ElementName=Root}" InputGestureText="Ctrl+O" />
        <MenuItem Header="Abrir esquemático..." Command="{Binding Workspace.OpenSchematicCommand, ElementName=Root}" />
        <Separator />
        <MenuItem Header="Abrir proyecto..." Command="{Binding Workspace.OpenProjectCommand, ElementName=Root}" />
        <MenuItem Header="Guardar proyecto" Command="{Binding Workspace.SaveCommand, ElementName=Root}" InputGestureText="Ctrl+S" />
        <MenuItem Header="Guardar proyecto como..." Command="{Binding Workspace.SaveAsCommand, ElementName=Root}" />
        <Separator />
        <MenuItem Header="Salir" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="Editar" />
      <MenuItem Header="Ver">
        <MenuItem Header="Geometry Inspector..." Click="OnGeometryInspectorClick" />
      </MenuItem>
      <MenuItem Header="Proyecto">
        <MenuItem Header="Abrir..." Command="{Binding Workspace.OpenProjectCommand, ElementName=Root}" />
        <MenuItem Header="Guardar" Command="{Binding Workspace.SaveCommand, ElementName=Root}" />
      </MenuItem>
      <MenuItem Header="Herramientas">
        <MenuItem Header="Geometry Inspector..." Click="OnGeometryInspectorClick" />
      </MenuItem>
      <MenuItem Header="Ventana" />
      <MenuItem Header="Ayuda" />
    </Menu>

    <Border Grid.Row="1"
            Background="{StaticResource ToolbarBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="12,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                  Command="{Binding Workspace.OpenBoardCommand, ElementName=Root}"
                  ToolTip="Abrir PDF de placa">
            <StackPanel MinWidth="82">
              <TextBlock Style="{StaticResource IconTextStyle}" Foreground="{StaticResource AccentBrush}" Text="&#xE8E5;" />
              <TextBlock Style="{StaticResource ToolLabelStyle}" Foreground="{StaticResource AccentBrush}" Text="Abrir placa" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                  Command="{Binding Workspace.OpenSchematicCommand, ElementName=Root}"
                  ToolTip="Abrir PDF de esquemático">
            <StackPanel MinWidth="100">
              <TextBlock Style="{StaticResource IconTextStyle}" Foreground="{StaticResource AccentBrush}" Text="&#xE8A5;" />
              <TextBlock Style="{StaticResource ToolLabelStyle}" Foreground="{StaticResource AccentBrush}" Text="Abrir esquema" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="10,4" Background="{StaticResource BorderBrush}" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Workspace.OpenProjectCommand, ElementName=Root}">
            <StackPanel MinWidth="76">
              <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8B7;" />
              <TextBlock Style="{StaticResource ToolLabelStyle}" Text="Proyecto" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Workspace.SaveCommand, ElementName=Root}">
            <StackPanel MinWidth="72">
              <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74E;" />
              <TextBlock Style="{StaticResource ToolLabelStyle}" Text="Guardar" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   Text="BOARDVIEW REPAIR WORKSPACE" />

        <Border Grid.Column="2"
                Margin="14,7,0,7"
                Padding="10,5"
                Background="{StaticResource ControlBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Referencia" />
            <TextBox x:Name="ReferenceTextBox"
                      Width="180"
                      Padding="7,3"
                      Background="#0B1118"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      KeyDown="OnReferenceTextBoxKeyDown"
                      Text="{Binding Workspace.ReferenceQuery, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="7,0,0,0"
                    Padding="14,3"
                    Click="OnReferenceSearchClick"
                    Content="Buscar" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="#0D1722"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Abra una placa y un esquemático desde la barra superior. Ambos documentos permanecerán visibles en esta única ventana." />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource WarningBrush}"
                   Text="Indexación PDFium alpha.13" />
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="190" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="310" MinWidth="250" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource PanelBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="EXPLORADOR" />
          <TextBlock Grid.Row="1" Margin="0,18,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="DOCUMENTOS DE TRABAJO" />
          <StackPanel Grid.Row="2">
            <Button Margin="0,0,0,8" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding Workspace.OpenBoardCommand, ElementName=Root}">
              <Border Padding="10" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#FF5252" Text="&#xEA90;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Placa" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Workspace.BoardFileName, ElementName=Root}" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
            <Button Margin="0,0,0,8" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding Workspace.OpenSchematicCommand, ElementName=Root}">
              <Border Padding="10" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#7E57C2" Text="&#xE8A5;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Esquemático" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Workspace.SchematicFileName, ElementName=Root}" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="MÓDULOS DISPONIBLES" />
            <ListBox Margin="0,8,0,0"
                     ItemsSource="{Binding SupportedFormats}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3" MinHeight="38">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="{Binding AccentColor}" CornerRadius="5">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" Text="{Binding IconGlyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Name}" />
                      <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Category}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

      <Border Grid.Column="2" Margin="8" Background="#0B1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#111D29" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FF5252" Text="&#xEA90;" />
                <TextBlock Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="BOARD" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Workspace.BoardFileName, ElementName=Root}" />
            </Grid>
          </Border>
          <controls:PdfDocumentView x:Name="BoardPdfDocumentView"
                                    Grid.Row="1"
                                    FilePath="{Binding Workspace.BoardFilePath, ElementName=Root}"
                                    PageNumber="{Binding Workspace.BoardPage, ElementName=Root}" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

      <Border Grid.Column="4" Margin="8" Background="#0B1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#111D29" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#7E57C2" Text="&#xE8A5;" />
                <TextBlock Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="SCHEMATIC" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Workspace.SchematicFileName, ElementName=Root}" />
            </Grid>
          </Border>
          <controls:PdfDocumentView x:Name="SchematicPdfDocumentView"
                                    Grid.Row="1"
                                    FilePath="{Binding Workspace.SchematicFilePath, ElementName=Root}"
                                    PageNumber="{Binding Workspace.SchematicPage, ElementName=Root}" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

      <Border Grid.Column="6"
              Background="{StaticResource PanelBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1,0,0,0">
        <TabControl Margin="8" Background="Transparent" BorderBrush="{StaticResource BorderBrush}">
          <TabItem Header="Resultados">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="Coincidencias de búsqueda" />
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding Workspace.SearchResultsView, ElementName=Root}"
                       SelectedItem="{Binding Workspace.SelectedSearchResult, ElementName=Root}"
                       Background="#0B1118"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       BorderBrush="{StaticResource BorderBrush}">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <Border Margin="0,6,0,2" Padding="8,5" Background="#172331">
                          <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding Name}" />
                        </Border>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Reference}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}">
                          <Run Text="{Binding DocumentRole}"/><Run Text=" · página "/><Run Text="{Binding PageNumber}"/><Run Text=" · "/><Run Text="{Binding Occurrences}"/><Run Text=" coincidencias"/>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="Componente">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="REFERENCIA ACTIVA" />
                <TextBlock Margin="0,6,0,14"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="{Binding Workspace.ActiveReference, ElementName=Root, TargetNullValue=—}" />

                <Border Padding="10" Background="#0B1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Placa" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Workspace.BoardLocationText, ElementName=Root}" />
                  </StackPanel>
                </Border>

                <Border Margin="0,8,0,0" Padding="10" Background="#0B1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Esquemático" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Workspace.SchematicLocationText, ElementName=Root}" />
                  </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="10" Background="#111D29" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <TextBlock TextWrapping="Wrap"
                             Foreground="{StaticResource WarningBrush}"
                             Text="{Binding Workspace.CrossProbeStatus, ElementName=Root}" />
                </Border>

                <TextBlock Margin="0,18,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Al seleccionar una coincidencia, BoardView navega y resalta la misma referencia en ambos documentos cuando está disponible." />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Notas">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBox Margin="0,0,0,6" Padding="6" Background="#0B1118" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" Text="{Binding Workspace.AnnotationTitle, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" ToolTip="Título" />
              <TextBox Grid.Row="1" Height="80" Margin="0,0,0,6" Padding="6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0B1118" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" Text="{Binding Workspace.AnnotationNotes, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" ToolTip="Observaciones" />
              <ComboBox Grid.Row="2" Margin="0,0,0,6" ItemsSource="{Binding Workspace.AvailableStatuses, ElementName=Root}" SelectedItem="{Binding Workspace.SelectedStatus, ElementName=Root}" />
              <Button Grid.Row="3" Margin="0,0,0,8" Padding="8,5" Command="{Binding Workspace.AddAnnotationCommand, ElementName=Root}" Content="Agregar nota" />
              <Button Grid.Row="4" Margin="0,0,0,8" Padding="8,5" Command="{Binding Workspace.RemoveAnnotationCommand, ElementName=Root}" Content="Eliminar seleccionada" />
              <ListBox Grid.Row="5"
                       ItemsSource="{Binding Workspace.Annotations, ElementName=Root}"
                       SelectedItem="{Binding Workspace.SelectedAnnotation, ElementName=Root}"
                       Background="#0B1118"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       BorderBrush="{StaticResource BorderBrush}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Reference}" />
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Notes}" />
                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource WarningBrush}" Text="{Binding Status}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Background="#0D1722"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Workspace.StatusMessage, ElementName=Root}" />
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}">
          <Run Text="Board pág. "/><Run Text="{Binding Workspace.BoardPage, ElementName=Root}"/><Run Text=" · Sch pág. "/><Run Text="{Binding Workspace.SchematicPage, ElementName=Root}"/>
        </TextBlock>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Text="BoardView 1.0.0-alpha.13" />
      </Grid>
    </Border>
  </Grid>
</Window>
