<UserControl x:Class="BoardView.App.Controls.PdfTileTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="640"
             MinHeight="480"
             Unloaded="OnUnloaded">

  <Grid Background="#F3F4F6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Selección del documento -->
    <Border Grid.Row="0"
            Margin="8"
            Padding="10"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="4">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Documento PDF:" />

        <TextBox x:Name="FilePathTextBox"
                 Grid.Column="1"
                 MinWidth="300"
                 Margin="0,0,8,0"
                 Padding="6"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center" />

        <Button Grid.Column="2"
                MinWidth="110"
                Padding="12,6"
                Click="SelectFileButton_Click"
                Content="Seleccionar..." />
      </Grid>
    </Border>

    <!-- Parámetros de renderizado -->
    <Border Grid.Row="1"
            Margin="8,0,8,8"
            Padding="10"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="4">

      <WrapPanel VerticalAlignment="Center">

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="Página" />

          <TextBox x:Name="PageNumberTextBox"
                   Width="70"
                   Padding="5"
                   Text="1" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="Zoom" />

          <TextBox x:Name="ZoomFactorTextBox"
                   Width="80"
                   Padding="5"
                   Text="1" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="X" />

          <TextBox x:Name="TileXTextBox"
                   Width="70"
                   Padding="5"
                   Text="0" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="Y" />

          <TextBox x:Name="TileYTextBox"
                   Width="70"
                   Padding="5"
                   Text="0" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="Ancho tesela" />

          <TextBox x:Name="TileWidthTextBox"
                   Width="100"
                   Padding="5"
                   Text="800" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0">
          <TextBlock Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Text="Alto tesela" />

          <TextBox x:Name="TileHeightTextBox"
                   Width="100"
                   Padding="5"
                   Text="800" />
        </StackPanel>

        <Button x:Name="RenderButton"
                MinWidth="120"
                Margin="0,20,0,0"
                Padding="14,6"
                Click="RenderButton_Click"
                Content="Renderizar" />
      </WrapPanel>
    </Border>

    <!-- Imagen producida por PDFium -->
    <Border Grid.Row="2"
            Margin="8,0,8,8"
            Background="#202124"
            BorderBrush="#9CA3AF"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="4">

      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

        <Grid>
          <TextBlock x:Name="EmptyMessageTextBlock"
                     Margin="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#E5E7EB"
                     FontSize="16"
                     Text="Selecciona un PDF y presiona Renderizar."
                     TextAlignment="Center"
                     TextWrapping="Wrap" />

          <Image x:Name="TileImage"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 RenderOptions.BitmapScalingMode="NearestNeighbor"
                 SnapsToDevicePixels="True"
                 Stretch="None" />
        </Grid>
      </ScrollViewer>
    </Border>

    <!-- Diagnóstico -->
    <Border Grid.Row="3"
            Margin="8,0,8,8"
            Padding="8"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="4">

      <TextBlock x:Name="StatusTextBlock"
                 Foreground="#111827"
                 Text="Motor PDFium preparado para la prueba visual."
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
