<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BoardView.Recognition</AssemblyName>
    <RootNamespace>BoardView.Recognition</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BoardView.Core\BoardView.Core.csproj" />
    <ProjectReference Include="..\BoardView.SemanticKernel\BoardView.SemanticKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Templates\Library\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Footprints\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>